pkgname=mkvclean
pkgver=0.5.1
pkgrel=1
pkgdesc='Extract English subtitles from MKV files and keep only the default English audio'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'mkvtoolnix-cli')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/mkvclean "$pkgdir/usr/bin/mkvclean"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/mkvclean.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/mkvclean.svg"
  install -Dm644 "$startdir/mkvclean.desktop" "$pkgdir/usr/share/applications/mkvclean.desktop"
  install -Dm644 "$startdir/mkvclean.service" "$pkgdir/usr/lib/systemd/user/mkvclean.service"
}
